[node name="Label" type="Label" parent="Player/Camera2D/StaticBody2D/DustStormInfo"]
offset_right = 799.0
offset_bottom = 499.0
text = "Welcome to your first Mars dust storm astronaut! This will be the only time you get this warning so read carefully! The danger of dust storms is not the wind, only the dust itself. This is because the atmosphere on Mars is so thin that the wind itself does not have enough power to destroy your equipment. In fact, the Martian atmosphere is only about 1% as dense as the Earth's atmosphere! On top of this, winds during dust storms on Mars only have an estimated maximum of 60 miles per hour, which is not very fast compared to Earth standards. However, the wind does have enough power to pick up the dust sitting on the surface. This is a problem because the dust particles are extremely small and electrostatic. This means that they stick to everything, like how styrofoam does. The dust is also very gritty, which can cause damage to moving parts. It can cause some of your equipment, such as your solar panels and MOXIE, to be non-operational, so be sure to clean off the dust from your equipment after storms! During the storm, take shelter in your base to prevent yourself from being harmed by the dust! For future storms, you can tell that a storm is going to occur soon by seeing the red alert in the top right of your screen. Good luck!"
label_settings = SubResource("LabelSettings_vm72l")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

