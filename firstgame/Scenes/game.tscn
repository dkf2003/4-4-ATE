[node name="Label" type="Label" parent="BasePlants/PlantInfoText"]
offset_right = 799.0
offset_bottom = 499.0
text = "Living on Mars is a challenge. One of those challenges that must be met is sustenance. Keeping astronauts well fed can keep them going on space exploration missions such as exploring Mars. Inside your base is where your agriculture will grow, come here and consume food by pressing ‘E’ on these plants. They will continuously grow as time goes on, however, this system relies on the water that gets pumped in from the extractor outside. If that extractor becomes damaged, then water will stop flowing and the plants will stop growing. Ensure to avoid this by repairing any damage to the water extractor well."
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

