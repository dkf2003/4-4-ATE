size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="WaterExtractor/Window"]
offset_right = 799.0
offset_bottom = 499.0
text = "“Water is where life is”. To survive on Mars, one must have access to water. Finding it on Mars is no easy task. Mars’ surface is practically an open desert. Nonetheless, water does exist on the planet and there are two main places it can be found (there are other locations but we will focus on these two). One is the poles of Mars, the second is the ice underneath the surface. Extracting water from the poles is far too difficult with temperatures reaching -240*F. The more practical choice is to drill below the surface and turn that ice into usable water. This water machine would likely be a “Rodriguez Well”, it is a type of machine that inserts a heat exchanger to melt the ice below and create a pocket of water. It is then pumped upwards to the surface for use. As you progress through this game you will have to maintain and fix any damage that appears on this machine. If not, water supply will stop, and the crops will stop growing. "
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

