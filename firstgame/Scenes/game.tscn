[node name="Window" type="Window" parent="SolarPanel"]
auto_translate_mode = 1
initial_position = 1
size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="SolarPanel/Window"]
offset_right = 799.0
offset_bottom = 499.0
text = "These are solar panels that create electricity by harnessing the energy of the sun. These are responsible for providing all of the electricity you are currently using to stay alive. These only come with a few drawbacks. The first is that they are less efficient than they are on Earth. Even though the atmosphere is thinner on Mars, blocking less of the sunlight, Mars is much further from the Sun than Earth. This results in Mars only receiving less than half the sunlight that Earth receives. Don't worry, though! There are enough solar panels here to sustain you and your machines. The second draw back is that due to the seasons on Mars, the power they generate is not always constant, but luckily for you, the base is located near the equator. This allows the solar panels to provide a predictable amount of energy all of the time! Just be sure to check on them once in a while, because dust could cover them, blocking any sunlight from reaching the panels!"
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

