[node name="BaseIntroText" type="Window" parent="."]
auto_translate_mode = 1
initial_position = 1
size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="BaseIntroText"]
offset_right = 799.0
offset_bottom = 499.0
text = "Welcome to your base! Here, you don't have to worry about oxygen or radiation. In order to protect you from radiation, the base has been built underground. The reason for this is because Mars does not have a atmosphere and magnetic field like Earth, which allows much more radiation from the Sun to reach the surface. The soil on top of you helps to save you from this! To learn about how your base is provided with oxygen, go over to the vent on the floor. To learn about your food supply, go over to the plants. To monitor the functionality of your life support systems, go over to the computer. Hope you find it comfy!"
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

