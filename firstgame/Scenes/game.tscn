[node name="Window" type="Window" parent="OxyGen"]
initial_position = 1
size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="OxyGen/Window"]
offset_right = 799.0
offset_bottom = 499.0
text = "This is a modified version of the Mars Oxygen In-Situ Resource Utilization Experiment, or MOXIE for short. The MOXIE provides fresh oxygen for you by extracting it from the atmosphere of Mars! It does this by first filtering the Martian air to remove any contaminants. Then the air is pressurized and sent through the Solid OXide Electrolyzer. The Solid OXide Electrolyzer, or SOXE, creates oxygen by putting the carbon dioxide molecules through an electrochemical process to be split into carbon monoxide and oxygen ions. Through this process, the MOXIE is able to produce the same amount of oxygen as a tree does on Earth! However, since this is not enough oxygen to sustain you, this machine is a scaled up version that can easily create enough oxygen for you. Just be sure to check the filters, because if they get blocked, this machine won't be able to make oxygen for you!"
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="SolarPanel" type="Node2D" parent="."]
script = ExtResource("20_7nbq1")

