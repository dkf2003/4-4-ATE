[node name="Window" type="Window" parent="MOXIEInput"]
auto_translate_mode = 1
initial_position = 1
size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="MOXIEInput/Window"]
offset_right = 799.0
offset_bottom = 499.0
text = "This is where the MOXIE draws air in from! It pulls in fresh martian air straight from the source, and due to it's high concentration of carbon dioxide, the MOXIE is able to produce oxygen for you! To learn more about the MOXIE, checkout the machine itself in your base! Be sure to come back here from time to time to check if the filter is covered with Mars dust, or else the MOXIE won't be able to make any oxygen!"
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

