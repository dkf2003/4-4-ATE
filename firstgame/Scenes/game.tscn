size = Vector2i(800, 500)
visible = false

[node name="Label" type="Label" parent="IntroText"]
offset_right = 799.0
offset_bottom = 499.0
text = "Welcome to Mars astronaut! Here, you can explore and learn about some of the different systems you would need to survive on Mars. In the top right, you will see four different colored bars. The red is for your health, green is for your hunger, yellow is for your energy, and blue is for your oxygen. If your oxygen or hunger bars start to decrease, you will start to lose health! You can refill your oxygen by going into your base that is east of you. Go on and explore your base to learn about all the different components! Don't worry about your oxygen orr hunger depleting while you're reading information, it won't go down! To get started, close this window."
label_settings = SubResource("LabelSettings_iivbl")
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

